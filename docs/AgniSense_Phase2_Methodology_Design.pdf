P S E U D O C O D E · 1 O F 3
Main program
START
open serial port; load settings
start = now; last_good = now; bad_count = 0
REPEAT
line = read line from Arduino
IF line is empty OR parse_line(line) fails THEN
IF line is not empty THEN bad_count = bad_count + 1
IF bad_count >= 5 THEN send FAULT("Bad data")
ELSE IF now - last_good > 5 s THEN send FAULT("No data")
CONTINUE
bad_count = 0; last_good = now
IF now - start < 120 s THEN
send WARMING UP(seconds left); CONTINUE
values = smooth(smoke, flame: last 5); temp unchanged
flags = classify(values)
level = hold_rule(decide_level(flags), now)
command = plan_outputs(level, values, flags)
send format_command(command)
print status; write row to CSV
END REPEAT
on stop: close log file and serial port

P S E U D O C O D E · 2 O F 3
Key functions: read, compare, decide, hold
parse_line(line)
reject unless:
5 fields, first field = "D"
all numbers valid
smoke and flame in 0..1023
"nan" temp or humidity -> missing
RETURN reading
classify(r)
smoke_high = r.smoke > 400
flame_high = r.flame > 300
temp_high = r.temp exists
AND r.temp > 45
RETURN the 3 flags
decide_level(flags)
RETURN number of true flags
(0 to 3)
hold_rule(new_level, now)
IF new_level >= level THEN
level = new_level; last_high = now
ELSE IF now - last_high >= 10 s THEN
level = new_level
RETURN level
A missing DHT11 reading counts as "not high".

P S E U D O C O D E · 3 O F 3
plan_outputs(level, values, flags)
Level LED Buzzer Fan LCD text
0 SAFE Green on Off Off "SAFE" + live S, F, T values
1 WARNING Yellow on Off Off "WARNING" / "Check the area"
2 POSSIBLE FIRE Yellow blinks Slow beeps Off "POSSIBLE FIRE" + names of high sensors
3 FIRE DETECTED Red on Continuous On "FIRE DETECTED" / "Fan ON - leave!"
WARMING UP Green blinks Off Off "WARMING UP" / seconds left
SENSOR FAULT Yellow blinks Slow beeps Off "SENSOR FAULT" / "Bad data" or "No data"
format_command(command)
remove "," and "|" from each LCD line; cut to 16 characters
RETURN "C,level,red,yellow,green,buzzer,fan,line1|line2"

Pseudocode
M A I N P R O G R A M
START
open serial port; load settings
warm-up timer = 120 s
REPEAT every second
line = read line from Arduino
IF line is not valid THEN
count bad line
IF 5 bad lines in a row THEN show SENSOR FAULT
CONTINUE
IF warm-up not finished THEN
show WARMING UP; CONTINUE
values = average of last 5 readings
smoke_high = values.smoke > 400
flame_high = values.flame > 300
temp_high = values.temp > 45
level = count of high flags (0 to 3)
level = hold_rule(level)
command = outputs_for(level)
send command to Arduino; log to CSV
END REPEAT
K E Y F U N C T I O N S
FUNCTION decide_level(smoke, flame, temp)
RETURN smoke + flame + temp (true = 1)
FUNCTION hold_rule(new_level, now)
IF new_level >= level THEN
level = new_level
remember now
ELSE IF now - last_high >= 10 s THEN
level = new_level
RETURN level
FUNCTION outputs_for(level)
0 SAFE : green ON
1 WARNING : yellow ON
2 POSSIBLE : yellow BLINK, slow beeps
3 FIRE : red ON, buzzer ON, fan ON
